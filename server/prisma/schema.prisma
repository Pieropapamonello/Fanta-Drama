generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  groups       GroupMember[]
}

model Group {
  id          String @id @default(cuid())
  name        String
  description String?
  code        String @unique
  image       String?
  createdAt   DateTime @default(now())
  members     GroupMember[]
}

model GroupMember {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id])
  userId    String
  group     Group  @relation(fields: [groupId], references: [id])
  groupId   String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime @default(now())
}

enum MemberRole { ADMIN MEMBER }

model Season {
  id        String @id @default(cuid())
  name      String
  start     DateTime
  end       DateTime
  group     Group  @relation(fields: [groupId], references: [id])
  groupId   String
}

model Event {
  id        String @id @default(cuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime
  group     Group @relation(fields: [groupId], references: [id])
  groupId   String
}

model Character {
  id       String @id @default(cuid())
  name     String
  nickname String?
  image    String?
  group    Group  @relation(fields: [groupId], references: [id])
  groupId  String
}

model DramaCard {
  id        String @id @default(cuid())
  title     String
  description String?
  rarity    Rarity @default(COMMON)
  type      ResponseType
  basePoints Int
  author    String?
  createdAt DateTime @default(now())
}

enum Rarity { COMMON UNCOMMON RARE EPIC LEGENDARY MYTHIC }
enum ResponseType { YES_NO PICK_CHARACTER MULTI_CHOICE NUMBER RANGE TIME TEXT FIRST_ACTION ORDER }

model Prediction {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id])
  userId    String
  event     Event  @relation(fields: [eventId], references: [id])
  eventId   String
  credits   Int
  createdAt DateTime @default(now())
}

model Vote {
  id        String @id @default(cuid())
  userId    String
  reportId  String
  value     Boolean
  createdAt DateTime @default(now())
}

model Badge {
  id    String @id @default(cuid())
  key   String @unique
  title String
}

model Notification {
  id      String @id @default(cuid())
  userId  String
  message String
  read    Boolean @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  token     String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String @id @default(cuid())
  action    String
  actorId   String?
  meta      Json?
  createdAt DateTime @default(now())
}
