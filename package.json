{
  "name": "fantadrama",
  "private": true,
  "version": "0.1.0",
  "description": "FantaDrama monorepo for a premium drama fantasy roster game with Telegram auth and live bot notifications.",
  "packageManager": "npm@10.11.0",
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build && npm --workspace server run build",
    "start": "npm --workspace server run start",
    "lint": "echo \"Run linters in workspaces\"",
    "format": "echo \"Format workspaces\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.6.0"
  }
}
